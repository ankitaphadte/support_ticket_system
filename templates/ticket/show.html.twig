{% extends 'base.html.twig' %}

{% block title %}Ticket #{{ ticket.id }}{% endblock %}

{% block body %}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>
                    <h2 class="fw-bold mb-1">
                        {{ ticket.title }}
                    </h2>

                    <span class="text-muted">
                        Ticket #{{ ticket.id }}
                    </span>
                </div>

                <span class="badge bg-primary fs-6">
                    {{ ticket.status }}
                </span>

            </div>


            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <div class="row mb-4">

                        <div class="col-md-4">
                            <small class="text-muted">
                                Category
                            </small>

                            <div class="fw-semibold">
                                {{ ticket.category }}
                            </div>
                        </div>


                        <div class="col-md-4">
                            <small class="text-muted">
                                Priority
                            </small>

                            <div class="fw-semibold">
                                {{ ticket.priority }}
                            </div>
                        </div>


                        <div class="col-md-4">
                            <small class="text-muted">
                                Created
                            </small>

                            <div class="fw-semibold">
                                {{ ticket.createdAt|date('d M Y, h:i A') }}
                            </div>
                        </div>

                    </div>


                    <hr>


                    <h5 class="mt-4">
                        Description
                    </h5>

                    <p>
                        {{ ticket.description }}
                    </p>


                    <hr>


                    <div class="mt-4">

                        <small class="text-muted">
                            Assigned Agent
                        </small>

                        <div>
                            {% if ticket.assignedTo %}
                                {{ ticket.assignedTo.firstName }}
                                {{ ticket.assignedTo.lastName }}
                            {% else %}
                                <span class="text-muted">
                                    Not assigned yet
                                </span>
                            {% endif %}
                        </div>

                    </div>

                </div>

            </div>


            <div class="mt-3">

                <a href="{{ path('app_ticket_list') }}"
                   class="btn btn-outline-secondary">
                    ← Back to My Tickets
                </a>
                <a
                    href="{{ path('app_ticket_edit', {'id': ticket.id}) }}"
                    class="btn btn-primary">
                    Edit Ticket
                </a>
                <form
                    method="post"
                    action="{{ path('app_ticket_delete', {'id': ticket.id}) }}"
                    onsubmit="return confirm('Are you sure you want to delete this ticket?');"
                    class="d-inline">

                    <input
                        type="hidden"
                        name="_token"
                        value="{{ csrf_token('delete' ~ ticket.id) }}"
                    >

                    <button
                        type="submit"
                        class="btn btn-danger">
                        Delete Ticket
                    </button>

                </form>
            </div>

        </div>

    </div>

</div>

{% endblock %}